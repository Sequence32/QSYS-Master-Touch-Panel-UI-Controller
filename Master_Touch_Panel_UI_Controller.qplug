  layout["Start_Transition"] = { Style = "ComboBox", Position = {0, y+20}, Size = {90, 20} }
  layout["System_Power_State"] = { Style = "Led", Legend = "Power Active", Position = {100, y}, Size = {90, 40} }
  layout["Shutdown_Page_TargetName"] = { Style = "ComboBox", Position = {200, y}, Size = {90, 20} }
  layout["Shutdown_Transition"] = { Style = "ComboBox", Position = {200, y+20}, Size = {90, 20} }
  y = y + 45
