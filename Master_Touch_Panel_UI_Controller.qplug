  y = y + 50
  
  table.insert(graphics, { Type = "Header", Text = "1. Active Script Routing Outputs (Debug)", Position = {0, y}, Size = {600, 20}, Color = header_color })
  table.insert(graphics, { Type = "Text", Text = "These display the explicit, live final target strings generated natively by the algorithm. Use this section strictly for troubleshooting designer routes.", Position = {10, y+20}, Size = {580, 25}, HTextAlign = "Left", FontStyle = "Italic" })
