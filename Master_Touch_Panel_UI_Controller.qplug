  layout["System_Shutdown_Request"] = { Style = "Button", Legend = "Shutdown Req", Position = {100, y}, Size = {90, 30} }
  layout["Shutdown_Confirm"] = { Style = "Button", Legend = "Confirm", Position = {200, y}, Size = {90, 30} }
