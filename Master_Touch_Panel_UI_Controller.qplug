PluginInfo = {
  Name = "Master Touch Panel UI Controller",
  Version = "7.2.9.15",
  BuildVersion = "7.2.2.0",
  Id = "master_tp_ui.7.2",
  Author = "Dustin Bennett",
  Description = "Dynamic UI driver tracking global topologies, using Native Component.New RPC Sync, executing direct Uci.SetLayerVisibility with Auto-Wake diagnostics."
}

-- Cap on derived Page 1 subpage count so 2^N doesn't explode for large wall counts.
local PAGE1_SUB_CAP = 20

-- Compute how many subpages Page 1 should expose given the active wall count.
-- Page 1 represents the global topology selector, so it has one subpage per wall-open combination (2^N).
local function ComputePage1Subs(wall_count)
  wall_count = wall_count or 0
  local n = math.floor(2 ^ wall_count + 0.5)
  if n > PAGE1_SUB_CAP then n = PAGE1_SUB_CAP end
  if n < 1 then n = 1 end
  return n
end

local function ResolveSubCount(page_idx, source)
  local entry = source["Page " .. page_idx .. " Alternate Subs"]
  if entry and entry.Value then return entry.Value end
  return 0
end

function GetColor(props) return { 102, 102, 102 } end
function GetPrettyName(props) return "Dynamic Master TP UI v7.2.2" end

-- 1. PROPERTIES
function GetProperties()
  local props = {}

  table.insert(props, { Name = "Room Association", Type = "string", Value = "A" })
  table.insert(props, { Name = "Total UI Drivers", Type = "integer", Min = 1, Max = 20, Value = 4 })
  table.insert(props, { Name = "Number of Walls", Type = "integer", Min = 0, Max = 10, Value = 2 })

  table.insert(props, { Name = "Target UCI Name", Type = "string", Value = "Lobby_Panel" })
  table.insert(props, { Name = "Target UCI Page", Type = "string", Value = "Main" })


  table.insert(props, { Name = "Startup Main Page", Type = "integer", Min = 1, Max = 20, Value = 1 })

  table.insert(props, { Name = "Number of Room Presets", Type = "integer", Min = 0, Max = 10, Value = 3 })
  table.insert(props, { Name = "Number of Popups", Type = "integer", Min = 0, Max = 20, Value = 3 })
  table.insert(props, { Name = "Number of Navigation Menus", Type = "integer", Min = 0, Max = 10, Value = 2 })
  table.insert(props, { Name = "Number of Main Pages", Type = "integer", Min = 1, Max = 20, Value = 10 })

  for i = 1, 20 do
    table.insert(props, { Name = "Page " .. i .. " Alternate Subs", Type = "integer", Min = 0, Max = 20, Value = 0 })
  end
  return props
end

-- 1b. RECTIFY PROPERTIES
-- Runs after any property change. Hides Page X entries beyond the active main page count and
-- pins Page 1 Subpages to the derived wall-combination total so the user can't edit it directly.
function RectifyProperties(props)
  local main_count = props["Number of Main Pages"].Value

  for i = 1, 20 do
    local alt_entry = props["Page " .. i .. " Alternate Subs"]
    local out_of_range = (i > main_count)

    if alt_entry then alt_entry.IsHidden = out_of_range end
  end

  return props
end

-- 2. CONTROLS
function GetControls(props)
  local ctrls = {}
  
  table.insert(ctrls, { Name = "RPC_Command", ControlType = "Text", Count = 1, UserPin = false, PinStyle = "Both" })

  table.insert(ctrls, { Name = "Current_Full_Page_Target", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Output" })
  table.insert(ctrls, { Name = "Current_Secondary_Sub_Target", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Output" })
  table.insert(ctrls, { Name = "Current_Popup_Target", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Output" })
  table.insert(ctrls, { Name = "Current_Topology", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Output" })
  
  table.insert(ctrls, { Name = "System_Start", ControlType = "Button", ButtonType = "Trigger", Count = 1, UserPin = true, PinStyle = "Both" })
  table.insert(ctrls, { Name = "System_Shutdown_Request", ControlType = "Button", ButtonType = "Trigger", Count = 1, UserPin = true, PinStyle = "Both" })
  table.insert(ctrls, { Name = "Shutdown_Confirm", ControlType = "Button", ButtonType = "Trigger", Count = 1, UserPin = true, PinStyle = "Both" })
  table.insert(ctrls, { Name = "Shutdown_Cancel", ControlType = "Button", ButtonType = "Trigger", Count = 1, UserPin = true, PinStyle = "Both" })
  table.insert(ctrls, { Name = "System_Power_On_Pulse", ControlType = "Button", ButtonType = "Trigger", Count = 1, UserPin = true, PinStyle = "Both" })
  table.insert(ctrls, { Name = "System_Power_Off_Pulse", ControlType = "Button", ButtonType = "Trigger", Count = 1, UserPin = true, PinStyle = "Both" })
  table.insert(ctrls, { Name = "System_Power_State", ControlType = "Indicator", IndicatorType = "Led", Count = 1, UserPin = true, PinStyle = "Output" })
  
  table.insert(ctrls, { Name = "Start_Page_TargetName", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Both" })
  table.insert(ctrls, { Name = "Shutdown_Page_TargetName", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Both" })
  
  table.insert(ctrls, { Name = "Start_Transition", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Both" })
  table.insert(ctrls, { Name = "Shutdown_Transition", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Both" })

  table.insert(ctrls, { Name = "Refresh_Target_Lists", ControlType = "Button", ButtonType = "Trigger", Count = 1, UserPin = true, PinStyle = "Both" })

  for i = 1, props["Number of Walls"].Value do
    table.insert(ctrls, { Name = "Wall_" .. i .. "_Open", ControlType = "Button", ButtonType = "Toggle", Count = 1, UserPin = true, PinStyle = "Both" })
    table.insert(ctrls, { Name = "Wall_" .. i .. "_Linkage", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Both" })
  end
  
  for i = 1, props["Number of Room Presets"].Value do
    table.insert(ctrls, { Name = "Room_Preset_" .. i, ControlType = "Button", ButtonType = "Trigger", Count = 1, UserPin = true, PinStyle = "Both" })
  end
  
  table.insert(ctrls, { Name = "Close_Popup", ControlType = "Button", ButtonType = "Trigger", Count = 1, UserPin = true, PinStyle = "Both" })
  for i = 1, props["Number of Popups"].Value do
    table.insert(ctrls, { Name = "Popup_" .. i .. "_Toggle", ControlType = "Button", ButtonType = "Toggle", Count = 1, UserPin = true, PinStyle = "Both" })
    table.insert(ctrls, { Name = "Popup_" .. i .. "_TargetName", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Both" })
    table.insert(ctrls, { Name = "Popup_" .. i .. "_Transition", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Both" })
  end

  for i = 1, props["Number of Navigation Menus"].Value do
    table.insert(ctrls, { Name = "Navigation_Menu_" .. i .. "_TargetName", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Both" })
    table.insert(ctrls, { Name = "Navigation_Menu_" .. i .. "_Transition", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Both" })
  end
  
  for i = 1, props["Number of Main Pages"].Value do
    table.insert(ctrls, { Name = "Main_Page_" .. i, ControlType = "Button", ButtonType = "Toggle", Count = 1, UserPin = true, PinStyle = "Both" })
    table.insert(ctrls, { Name = "Main_Page_" .. i .. "_TargetName", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Both" })
    table.insert(ctrls, { Name = "Main_Page_" .. i .. "_Transition", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Both" })
    table.insert(ctrls, { Name = "Main_Page_" .. i .. "_Local_Only", ControlType = "Button", ButtonType = "Toggle", Count = 1, UserPin = true, PinStyle = "Both" })
    
    local alt_count = ComputePage1Subs(props["Number of Walls"].Value)
    for k = 0, alt_count - 1 do
      table.insert(ctrls, { Name = "Main_Page_" .. i .. "_Alt_" .. k .. "_Active", ControlType = "Indicator", IndicatorType = "Led", Count = 1, UserPin = true, PinStyle = "Output" })
    end

    local sub_count = ResolveSubCount(i, props)
    for j = 1, sub_count do
       table.insert(ctrls, { Name = "Main_" .. i .. "_Sub_" .. j, ControlType = "Button", ButtonType = "Toggle", Count = 1, UserPin = true, PinStyle = "Both" })
       table.insert(ctrls, { Name = "Main_" .. i .. "_Sub_" .. j .. "_TargetName", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Both" })
       table.insert(ctrls, { Name = "Main_" .. i .. "_Sub_" .. j .. "_Transition", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Both" })
    end
  end
  
  return ctrls
end

