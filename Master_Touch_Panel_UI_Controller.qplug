PluginInfo = {
  Name = "Master Touch Panel UI Controller",
  Version = "7.2.9.35",
  BuildVersion = "7.2.2.1",
  Id = "master_tp_ui.7.2",
  Author = "Dustin Bennett",
  Description = "Dynamic UI driver tracking global topologies, using Native Component.New RPC Sync, executing direct Uci.SetLayerVisibility with Auto-Wake diagnostics."
}

-- Cap on derived Page 1 subpage count so 2^N doesn't explode for large wall counts.
local PAGE1_SUB_CAP = 20

-- Compute how many subpages Page 1 should expose given the active wall count.
-- Page 1 represents the global topology selector, so it has one subpage per wall-open combination (2^N).
local function ComputePage1Subs(wall_count)
  wall_count = wall_count or 0
  local n = math.floor(2 ^ wall_count + 0.5)
  if n > PAGE1_SUB_CAP then n = PAGE1_SUB_CAP end
  if n < 1 then n = 1 end
  return n
end

local function ResolveSubCount(page_idx, source)
  local entry = source["Page " .. page_idx .. " Alternate Subs"]
  if entry and entry.Value then return entry.Value end
  return 0
end

function GetColor(props) return { 102, 102, 102 } end
function GetPrettyName(props) return "Dynamic Master TP UI v7.2.2" end

-- 1. PROPERTIES
function GetProperties()
  local props = {}

  table.insert(props, { Name = "Room Association", Type = "string", Value = "A" })
  -- Peers find each other by Component code name = <prefix><Room letter>, e.g.
  -- "MasterTouchPanelUIController_B". Set this to match the code names you give the
  -- panels (and enable Script Access on each). Must be identical on every panel.
  table.insert(props, { Name = "Peer Code Name Prefix", Type = "string", Value = "MasterTouchPanelUIController_" })
  table.insert(props, { Name = "Total UI Drivers", Type = "integer", Min = 1, Max = 20, Value = 4 })
  table.insert(props, { Name = "Number of Walls", Type = "integer", Min = 0, Max = 10, Value = 2 })
  -- Read wall state straight from the Wall State Manager component (no need to wire
  -- each panel's Wall_x_Open). '#' in the pin pattern is replaced by the wall number.
  -- Leave the code name blank to disable and use only the wired Wall_x_Open pins.
  table.insert(props, { Name = "Wall State Manager Code Name", Type = "string", Value = "WallStateManagerv2" })
  table.insert(props, { Name = "Wall State Pin Pattern", Type = "string", Value = "Wall.#.Out" })

  table.insert(props, { Name = "Target UCI Name", Type = "string", Value = "Lobby_Panel" })
  table.insert(props, { Name = "Target UCI Page", Type = "string", Value = "Main" })
  -- Welcome/idle layer shown when the system is OFF (after Shutdown Confirm). Bare
  -- layer name, no topology suffix. Leave blank for a truly blank off-state.
  table.insert(props, { Name = "Start System Page", Type = "string", Value = "Start_Page" })
  -- Extra layer(s) this engine should ALWAYS keep hidden unless they're the active
  -- layer. Comma-separated, e.g. "Welcome,Splash". Usually leave blank.
  table.insert(props, { Name = "Idle Layers To Hide", Type = "string", Value = "" })



  table.insert(props, { Name = "Number of Room Presets", Type = "integer", Min = 0, Max = 10, Value = 3 })
  table.insert(props, { Name = "Number of Popups", Type = "integer", Min = 0, Max = 20, Value = 3 })
  table.insert(props, { Name = "Number of Navigation Menus", Type = "integer", Min = 0, Max = 10, Value = 2 })
  table.insert(props, { Name = "Number of Main Pages", Type = "integer", Min = 1, Max = 20, Value = 10 })

  for i = 1, 20 do
    table.insert(props, { Name = "Page " .. i .. " Alternate Subs", Type = "integer", Min = 0, Max = 20, Value = 0 })
  end
  return props
end

-- 1b. RECTIFY PROPERTIES
-- Runs after any property change. Hides Page X entries beyond the active main page count and
-- pins Page 1 Subpages to the derived wall-combination total so the user can't edit it directly.
function RectifyProperties(props)
  local main_count = props["Number of Main Pages"].Value

  for i = 1, 20 do
    local alt_entry = props["Page " .. i .. " Alternate Subs"]
    local out_of_range = (i > main_count)

    if alt_entry then alt_entry.IsHidden = out_of_range end
  end

  return props
end

-- 2. CONTROLS
function GetControls(props)
  local ctrls = {}
  
  table.insert(ctrls, { Name = "RPC_Command", ControlType = "Text", Count = 1, UserPin = false, PinStyle = "Both" })

  table.insert(ctrls, { Name = "Current_Full_Page_Target", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Output" })
  table.insert(ctrls, { Name = "Current_Secondary_Sub_Target", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Output" })
  table.insert(ctrls, { Name = "Current_Popup_Target", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Output" })
  table.insert(ctrls, { Name = "Current_Topology", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Output" })
  
  table.insert(ctrls, { Name = "System_Start", ControlType = "Button", ButtonType = "Trigger", Count = 1, UserPin = true, PinStyle = "Both" })
  table.insert(ctrls, { Name = "System_Shutdown_Request", ControlType = "Button", ButtonType = "Trigger", Count = 1, UserPin = true, PinStyle = "Both" })
  table.insert(ctrls, { Name = "Shutdown_Confirm", ControlType = "Button", ButtonType = "Trigger", Count = 1, UserPin = true, PinStyle = "Both" })
  table.insert(ctrls, { Name = "Shutdown_Cancel", ControlType = "Button", ButtonType = "Trigger", Count = 1, UserPin = true, PinStyle = "Both" })
  table.insert(ctrls, { Name = "System_Power_On_Pulse", ControlType = "Button", ButtonType = "Trigger", Count = 1, UserPin = true, PinStyle = "Both" })
  table.insert(ctrls, { Name = "System_Power_Off_Pulse", ControlType = "Button", ButtonType = "Trigger", Count = 1, UserPin = true, PinStyle = "Both" })
  table.insert(ctrls, { Name = "System_Power_State", ControlType = "Indicator", IndicatorType = "Led", Count = 1, UserPin = true, PinStyle = "Output" })
  
  table.insert(ctrls, { Name = "Start_Page_TargetName", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Both" })
  table.insert(ctrls, { Name = "Shutdown_Page_TargetName", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Both" })
  
  table.insert(ctrls, { Name = "Start_Transition", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Both" })
  table.insert(ctrls, { Name = "Shutdown_Transition", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Both" })

  for i = 1, props["Number of Walls"].Value do
    table.insert(ctrls, { Name = "Wall_" .. i .. "_Open", ControlType = "Button", ButtonType = "Toggle", Count = 1, UserPin = true, PinStyle = "Both" })
    table.insert(ctrls, { Name = "Wall_" .. i .. "_Linkage", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Both" })
  end
  
  for i = 1, props["Number of Room Presets"].Value do
    table.insert(ctrls, { Name = "Room_Preset_" .. i, ControlType = "Button", ButtonType = "Trigger", Count = 1, UserPin = true, PinStyle = "Both" })
  end
  
  table.insert(ctrls, { Name = "Close_Popup", ControlType = "Button", ButtonType = "Trigger", Count = 1, UserPin = true, PinStyle = "Both" })
  for i = 1, props["Number of Popups"].Value do
    table.insert(ctrls, { Name = "Popup_" .. i .. "_Toggle", ControlType = "Button", ButtonType = "Toggle", Count = 1, UserPin = true, PinStyle = "Both" })
    table.insert(ctrls, { Name = "Popup_" .. i .. "_TargetName", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Both" })
    table.insert(ctrls, { Name = "Popup_" .. i .. "_Transition", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Both" })
  end

  for i = 1, props["Number of Navigation Menus"].Value do
    table.insert(ctrls, { Name = "Navigation_Menu_" .. i .. "_TargetName", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Both" })
    table.insert(ctrls, { Name = "Navigation_Menu_" .. i .. "_Transition", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Both" })
  end
  
  for i = 1, props["Number of Main Pages"].Value do
    table.insert(ctrls, { Name = "Main_Page_" .. i, ControlType = "Button", ButtonType = "Toggle", Count = 1, UserPin = true, PinStyle = "Both" })
    table.insert(ctrls, { Name = "Main_Page_" .. i .. "_TargetName", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Both" })
    table.insert(ctrls, { Name = "Main_Page_" .. i .. "_Transition", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Both" })
    table.insert(ctrls, { Name = "Main_Page_" .. i .. "_Local_Only", ControlType = "Button", ButtonType = "Toggle", Count = 1, UserPin = true, PinStyle = "Both" })
    
    local alt_count = ComputePage1Subs(props["Number of Walls"].Value)
    for k = 0, alt_count - 1 do
      table.insert(ctrls, { Name = "Main_Page_" .. i .. "_Alt_" .. k .. "_Active", ControlType = "Indicator", IndicatorType = "Led", Count = 1, UserPin = true, PinStyle = "Output" })
    end

    local sub_count = ResolveSubCount(i, props)
    for j = 1, sub_count do
       table.insert(ctrls, { Name = "Main_" .. i .. "_Sub_" .. j, ControlType = "Button", ButtonType = "Toggle", Count = 1, UserPin = true, PinStyle = "Both" })
       table.insert(ctrls, { Name = "Main_" .. i .. "_Sub_" .. j .. "_TargetName", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Both" })
       table.insert(ctrls, { Name = "Main_" .. i .. "_Sub_" .. j .. "_Transition", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Both" })
    end
  end
  
  return ctrls
end

-- 3. LAYOUT
function GetControlLayout(props)
  local layout = {}
  local graphics = {}
  local header_color = {200, 200, 200}
  local sys_color = {255, 150, 150}
  
  local y = 0
  
  table.insert(graphics, { Type = "Header", Text = "0. INSTRUCTIONS FOR MULTI-ROOM SYNC", Position = {0, y}, Size = {600, 20}, Color = sys_color })
  table.insert(graphics, { Type = "Text", Text = string.format("For panels to sync automatically via walls, you MUST select this block, enable 'Script Access', and set its Code Name strictly to: %s%s", props["Peer Code Name Prefix"].Value, props["Room Association"].Value), Position = {10, y+20}, Size = {580, 25}, HTextAlign = "Left", FontStyle = "Bold" })
  y = y + 50
  
  table.insert(graphics, { Type = "Header", Text = "1. Active Script Routing Outputs (Debug)", Position = {0, y}, Size = {600, 20}, Color = header_color })
  table.insert(graphics, { Type = "Text", Text = "These display the explicit, live final target strings generated natively by the algorithm. Use this section strictly for troubleshooting designer routes.", Position = {10, y+20}, Size = {580, 25}, HTextAlign = "Left", FontStyle = "Italic" })
  y = y + 50
  
  layout["Current_Full_Page_Target"] = { Style = "Text", Position = {0, y}, Size = {130, 20} }
  layout["Current_Secondary_Sub_Target"] = { Style = "Text", Position = {135, y}, Size = {130, 20} }
  layout["Current_Popup_Target"] = { Style = "Text", Position = {270, y}, Size = {130, 20} }
  y = y + 25
  layout["Current_Topology"] = { Style = "Text", Position = {0, y}, Size = {130, 20} }
  y = y + 40
  
  table.insert(graphics, { Type = "Header", Text = "2. System Power State Engine - Room (" .. props["Room Association"].Value .. ")", Position = {0, y}, Size = {600, 20}, Color = sys_color })
  table.insert(graphics, { Type = "Text", Text = "Central power controls, synchronized across rooms via RPC. The dropdown under Sys Start picks which Main Page opens on power-on (by name). Powered OFF (after Shutdown Confirm) is intentionally blank.", Position = {10, y+20}, Size = {580, 25}, HTextAlign = "Left", FontStyle = "Italic" })
  y = y + 50
  
  layout["System_Start"] = { Style = "Button", Legend = "Sys Start", Position = {0, y}, Size = {90, 30} }
  layout["System_Shutdown_Request"] = { Style = "Button", Legend = "Shutdown Req", Position = {100, y}, Size = {90, 30} }
  layout["Shutdown_Confirm"] = { Style = "Button", Legend = "Confirm", Position = {200, y}, Size = {90, 30} }
  layout["Shutdown_Cancel"] = { Style = "Button", Legend = "Cancel", Position = {300, y}, Size = {90, 30} }
  y = y + 35
  layout["Start_Page_TargetName"] = { Style = "ComboBox", Position = {0, y}, Size = {90, 20} }
  layout["Start_Transition"] = { Style = "ComboBox", Position = {0, y+20}, Size = {90, 20} }
  layout["System_Power_State"] = { Style = "Led", Legend = "Power Active", Position = {100, y}, Size = {90, 40} }
  layout["Shutdown_Page_TargetName"] = { Style = "ComboBox", Position = {200, y}, Size = {90, 20} }
  layout["Shutdown_Transition"] = { Style = "ComboBox", Position = {200, y+20}, Size = {90, 20} }
  y = y + 45
  layout["System_Power_On_Pulse"] = { Style = "Button", Legend = "Power ON Trigger", Position = {50, y}, Size = {130, 30} }
  layout["System_Power_Off_Pulse"] = { Style = "Button", Legend = "Power OFF Trigger", Position = {210, y}, Size = {130, 30} }
  y = y + 55
  
  local wx = props["Number of Walls"].Value
  if wx > 0 then
    table.insert(graphics, { Type = "Header", Text = "3. Combinable Wall Sensors", Position = {0, y}, Size = {600, 20}, Color = header_color })
    table.insert(graphics, { Type = "Text", Text = string.format("Wall state is auto-read from '%s' (%s). No wiring needed; the Wall_x_Open pins below still work as a manual override.", props["Wall State Manager Code Name"].Value, props["Wall State Pin Pattern"].Value), Position = {10, y+20}, Size = {580, 25}, HTextAlign = "Left", FontStyle = "Italic" })
    y = y + 50
    for i = 1, wx do
      layout["Wall_" .. i .. "_Open"] = { Style = "Button", Legend = "Wall " .. i .. " Open", Position = {(i-1)*130, y}, Size = {90, 30} }
      layout["Wall_" .. i .. "_Linkage"] = { Style = "Text", Position = {(i-1)*130, y+35}, Size = {90, 20} }
    end
    y = y + 75
  end
  
  local popx = props["Number of Popups"].Value
  if popx > 0 then
    table.insert(graphics, { Type = "Header", Text = "4. Popup Engine Overlays", Position = {0, y}, Size = {600, 20}, Color = header_color })
    table.insert(graphics, { Type = "Text", Text = "Execute native popups independent of any topology constraints. Use 'TargetName' inputs to dynamically map active layers against designer components.", Position = {10, y+20}, Size = {580, 25}, HTextAlign = "Left", FontStyle = "Italic" })
    y = y + 50
    layout["Close_Popup"] = { Style = "Button", Legend = "Close Popup", Position = {0, y}, Size = {80, 50} }
    for i = 1, popx do
      layout["Popup_" .. i .. "_Toggle"] = { Style = "Button", Legend = "Pop " .. i, Position = {85 + (i-1)*90, y}, Size = {85, 30} }
      -- ComboBox so Choices populated at runtime render as a real dropdown; users can still type a layer name manually.
      layout["Popup_" .. i .. "_TargetName"] = { Style = "ComboBox", Position = {85 + (i-1)*90, y+35}, Size = {85, 20} }
      layout["Popup_" .. i .. "_Transition"] = { Style = "ComboBox", Position = {85 + (i-1)*90, y+55}, Size = {85, 20} }
    end
    y = y + 90
  end

  local navx = props["Number of Navigation Menus"].Value
  if navx > 0 then
    table.insert(graphics, { Type = "Header", Text = "5. Always-On Navigation Menus", Position = {0, y}, Size = {600, 20}, Color = header_color })
    table.insert(graphics, { Type = "Text", Text = "Explicitly target static navigation bars rendering on top of base layers securely.", Position = {10, y+20}, Size = {580, 25}, HTextAlign = "Left", FontStyle = "Italic" })
    y = y + 50
    for i = 1, navx do
      table.insert(graphics, { Type = "Text", Text = "Nav " .. i, Position = {0, y}, Size = {80, 20}, HTextAlign = "Right" })
      layout["Navigation_Menu_" .. i .. "_TargetName"] = { Style = "ComboBox", Position = {85, y}, Size = {150, 20} }
      layout["Navigation_Menu_" .. i .. "_Transition"] = { Style = "ComboBox", Position = {245, y}, Size = {100, 20} }
      y = y + 25
    end
    y = y + 25
  end

  local presetx = props["Number of Room Presets"].Value
  if presetx > 0 then
    table.insert(graphics, { Type = "Header", Text = "5b. Room Presets", Position = {0, y}, Size = {600, 20}, Color = header_color })
    table.insert(graphics, { Type = "Text", Text = "Execute room presets, syncing across connected topologies.", Position = {10, y+20}, Size = {580, 25}, HTextAlign = "Left", FontStyle = "Italic" })
    y = y + 50
    for i = 1, presetx do
      layout["Room_Preset_" .. i] = { Style = "Button", Legend = "Preset " .. i, Position = {(i-1)*90, y}, Size = {85, 30} }
    end
    y = y + 45
  end

  table.insert(graphics, { Type = "Header", Text = "6. Hierarchical Navigation Router", Position = {0, y}, Size = {600, 20}, Color = header_color })
  table.insert(graphics, { Type = "Text", Text = "Define main routes seamlessly tracking explicit topology math. 'Local Only' targets the bare layer name with NO room/topology suffix appended. Subpages are strictly bound securely bypassing combiners naturally. Targets are automatically pulled live from the UCI.", Position = {10, y+22}, Size = {580, 45}, HTextAlign = "Left", FontStyle = "Italic" })
  y = y + 75
  for i = 1, props["Number of Main Pages"].Value do
    layout["Main_Page_" .. i] = { Style = "Button", Legend = "Main " .. i, Position = {0, y}, Size = {85, 30} }
    layout["Main_Page_" .. i .. "_TargetName"] = { Style = "ComboBox", Position = {85, y}, Size = {90, 20} }
    layout["Main_Page_" .. i .. "_Transition"] = { Style = "ComboBox", Position = {175, y}, Size = {90, 20} }
    layout["Main_Page_" .. i .. "_Local_Only"] = { Style = "Button", Legend = "Local Only", Position = {265, y}, Size = {80, 30} }

    local sub_count = ResolveSubCount(i, props)
    if sub_count > 0 then y = y + 35 end
    for j = 1, sub_count do
       layout["Main_" .. i .. "_Sub_" .. j] = { Style = "Button", Legend = "Sub " .. j, Position = {25 + (j-1)*100, y}, Size = {95, 30} }
       layout["Main_" .. i .. "_Sub_" .. j .. "_TargetName"] = { Style = "ComboBox", Position = {25 + (j-1)*100, y+35}, Size = {95, 20} }
       layout["Main_" .. i .. "_Sub_" .. j .. "_Transition"] = { Style = "ComboBox", Position = {25 + (j-1)*100, y+55}, Size = {95, 20} }
    end
    if sub_count > 0 then y = y + 55 end
    y = y + 35
  end
  
  return layout, graphics
end

-- 4. RUNTIME
if Controls then
  local sys_state = 0
  local local_room = Properties["Room Association"].Value
  
  local uci_name = Properties["Target UCI Name"].Value
  local uci_page = Properties["Target UCI Page"].Value
  local start_sys_page = Properties["Start System Page"].Value

  -- Parse the "Idle Layers To Hide" CSV into a trimmed list once.
  local idle_hide_layers = {}
  for name in tostring(Properties["Idle Layers To Hide"].Value):gmatch("[^,]+") do
     local nm = name:match("^%s*(.-)%s*$")
     if nm ~= "" then table.insert(idle_hide_layers, nm) end
  end

  local wall_count = Properties["Number of Walls"].Value
  local main_count = Properties["Number of Main Pages"].Value
  local preset_count = Properties["Number of Room Presets"].Value
  local popup_count = Properties["Number of Popups"].Value
  local nav_count = Properties["Number of Navigation Menus"].Value

  local wall_mgr_name = Properties["Wall State Manager Code Name"].Value
  local wall_pin_pat  = Properties["Wall State Pin Pattern"].Value

  local peer_prefix = Properties["Peer Code Name Prefix"].Value
  
  local active_main = 1  -- corrected to the Sys Start dropdown selection on power-on
  local active_subs = {}
  for i = 1, main_count do active_subs[i] = 1 end
  
  local active_popup = 0

  -- Last visibility we DROVE for each layer name. Drives transition choice (fade only
  -- on a real change) and lets us always re-assert so late/reconnected panels converge.
  local layer_state = {}

  local trans_choices = {"none", "fade", "slide right", "slide left", "slide up", "slide down"}
  
  Controls.Start_Transition.Choices = trans_choices
  if Controls.Start_Transition.String == "" then Controls.Start_Transition.String = "fade" end
  Controls.Shutdown_Transition.Choices = trans_choices
  if Controls.Shutdown_Transition.String == "" then Controls.Shutdown_Transition.String = "fade" end

  -- Sys Start dropdown = which MAIN PAGE opens on power-on (matched by target name).
  -- Defaults to the first main page. Shutdown_Page = the confirm dialog (state 2).
  if Controls.Start_Page_TargetName and Controls.Start_Page_TargetName.String == "" then
     Controls.Start_Page_TargetName.String = "Page_1"
  end
  if Controls.Shutdown_Page_TargetName and Controls.Shutdown_Page_TargetName.String == "" then
     Controls.Shutdown_Page_TargetName.String = "Shutdown_Page"
  end

  for i = 1, popup_count do
     Controls["Popup_"..i.."_Transition"].Choices = trans_choices
     if Controls["Popup_"..i.."_Transition"].String == "" then Controls["Popup_"..i.."_Transition"].String = "fade" end
     if Controls["Popup_"..i.."_TargetName"].String == "" then Controls["Popup_"..i.."_TargetName"].String = "Popup_"..i end
  end

  for i = 1, nav_count do
     Controls["Navigation_Menu_"..i.."_Transition"].Choices = trans_choices
     if Controls["Navigation_Menu_"..i.."_Transition"].String == "" then Controls["Navigation_Menu_"..i.."_Transition"].String = "fade" end
     if Controls["Navigation_Menu_"..i.."_TargetName"].String == "" then Controls["Navigation_Menu_"..i.."_TargetName"].String = "Nav_"..i end
  end
  
  for i = 1, main_count do
     Controls["Main_Page_"..i.."_Transition"].Choices = trans_choices
     if Controls["Main_Page_"..i.."_Transition"].String == "" then Controls["Main_Page_"..i.."_Transition"].String = "fade" end
     if Controls["Main_Page_"..i.."_TargetName"].String == "" then Controls["Main_Page_"..i.."_TargetName"].String = "Page_"..i end

     local sub_cnt = ResolveSubCount(i, Properties)
     for j = 1, sub_cnt do
        Controls["Main_"..i.."_Sub_"..j.."_Transition"].Choices = trans_choices
        if Controls["Main_"..i.."_Sub_"..j.."_Transition"].String == "" then Controls["Main_"..i.."_Sub_"..j.."_Transition"].String = "fade" end
        if Controls["Main_"..i.."_Sub_"..j.."_TargetName"].String == "" then Controls["Main_"..i.."_Sub_"..j.."_TargetName"].String = "Sub_"..j end
     end
  end
  
  -- Strip a Q-SYS topology suffix (e.g. "-AB", "-A") from a layer name so the dropdown shows the base layer.
  local function StripTopologySuffix(name)
    if not name then return name end
    return name:gsub("%-[A-Z]+$", "")
  end

  -- Push the same list of layer-base-name choices to every TargetName control we manage.
  local function ApplyChoicesToTargetControls(compiled_choices)
    if Controls.Start_Page_TargetName then Controls.Start_Page_TargetName.Choices = compiled_choices end
    if Controls.Shutdown_Page_TargetName then Controls.Shutdown_Page_TargetName.Choices = compiled_choices end
    for i = 1, nav_count do
      Controls["Navigation_Menu_"..i.."_TargetName"].Choices = compiled_choices
    end
    for i = 1, popup_count do
      Controls["Popup_"..i.."_TargetName"].Choices = compiled_choices
    end
    for i = 1, main_count do
      Controls["Main_Page_"..i.."_TargetName"].Choices = compiled_choices
      local s_cnt = ResolveSubCount(i, Properties)
      for j = 1, s_cnt do
        Controls["Main_"..i.."_Sub_"..j.."_TargetName"].Choices = compiled_choices
      end
    end
  end

  -- Strategy 1: try Uci.GetLayers (only exists on some Q-SYS builds).
  local function TryUciGetLayers()
    if not (Uci and Uci.GetLayers) then return nil end
    local ok, results = pcall(Uci.GetLayers, uci_name, uci_page)
    if not ok or type(results) ~= "table" then return nil end
    local seen = {}
    for _, L in ipairs(results) do
      if L.Name then seen[StripTopologySuffix(L.Name)] = true end
    end
    return seen
  end

  -- Strategy 2: parse the UCI design JSON (works in Designer emulation and on Core).
  -- Mirrors the approach used in the q-sys-module-uci-plus community module.
  local function TryParseDesignJson()
    local ok_req, json = pcall(require, "rapidjson")
    if not ok_req or not json then return nil end
    local ok_open, fh = pcall(io.open, "design/ucis.json", "r")
    if not ok_open or not fh then return nil end
    local text = fh:read("*a")
    fh:close()
    if not text or text == "" then return nil end
    local ok_dec, parsed = pcall(json.decode, text)
    if not ok_dec or type(parsed) ~= "table" or not parsed.Ucis then return nil end
    local seen = {}
    for _, U in ipairs(parsed.Ucis) do
      if U.Name == uci_name and type(U.Pages) == "table" then
        for _, P in ipairs(U.Pages) do
          local match_page = (uci_page == "" or P.Name == uci_page)
          if match_page and type(P.Layers) == "table" then
            for _, L in ipairs(P.Layers) do
              if L.Name then seen[StripTopologySuffix(L.Name)] = true end
            end
          end
        end
      end
    end
    return seen
  end

  -- Strategy 3: synthesize sensible defaults from the user-entered TargetName strings already present.
  -- This keeps the dropdown populated even when no UCI introspection API is available.
  local function HarvestExistingTargets()
    local seen = {}
    if Controls.Start_Page_TargetName then
      local s1 = Controls.Start_Page_TargetName.String
      if s1 and s1 ~= "" then seen[s1] = true end
    end
    if Controls.Shutdown_Page_TargetName then
      local s2 = Controls.Shutdown_Page_TargetName.String
      if s2 and s2 ~= "" then seen[s2] = true end
    end
    
    for i = 1, nav_count do
       local s = Controls["Navigation_Menu_"..i.."_TargetName"].String
       if s and s ~= "" then seen[s] = true end
    end
    for i = 1, popup_count do
      local s = Controls["Popup_"..i.."_TargetName"].String
      if s and s ~= "" then seen[s] = true end
    end
    for i = 1, main_count do
      local s = Controls["Main_Page_"..i.."_TargetName"].String
      if s and s ~= "" then seen[s] = true end
      local s_cnt = ResolveSubCount(i, Properties)
      for j = 1, s_cnt do
        local sub = Controls["Main_"..i.."_Sub_"..j.."_TargetName"].String
        if sub and sub ~= "" then seen[sub] = true end
      end
    end
    return seen
  end

  local function ScrapeUciLayers()
    if uci_name == "" then
      print("INFO: UCI scrape skipped. Set the 'Target UCI Name' property first.")
      return
    end

    local raw = TryUciGetLayers()
    local source = "Uci.GetLayers API"

    if not raw or next(raw) == nil then
      raw = TryParseDesignJson()
      source = "design/ucis.json"
    end

    if not raw or next(raw) == nil then
      raw = HarvestExistingTargets()
      source = "existing TargetName entries"
    end

    local compiled = {}
    for k, _ in pairs(raw or {}) do table.insert(compiled, k) end
    table.sort(compiled)

    if #compiled > 0 then
      print(string.format("UCI layer scrape OK (%d entries) via %s.", #compiled, source))
      ApplyChoicesToTargetControls(compiled)
    else
      print("WARNING: No UCI layers discovered. Manual entry remains available; type names directly into the ComboBox fields.")
    end
  end

  local function SetLayerSafe(layer, isVisible, transition, quiet)
    if layer and layer ~= "" and uci_name ~= "" and uci_page ~= "" then
       local trans = transition or "none"
       -- quiet = a periodic re-assert that isn't changing anything; skip the print
       -- so the console only shows real transitions, not the convergence chatter.
       if not quiet then
          print(string.format("Layer Cmd -> %s : Visible=%s", layer, tostring(isVisible)))
       end
       pcall(function() Uci.SetLayerVisibility(uci_name, uci_page, layer, isVisible, trans) end)
       pcall(function() Uci.SetSharedLayerVisibility(uci_name, layer, isVisible, trans) end)
    end
  end
  
  -- Flood-fill the room graph for an arbitrary wall-open state. is_open(w) returns the
  -- open/closed boolean for wall w, so this serves both the live topology and the
  -- "what topologies are possible" enumeration below.
  local function ComputeTopology(is_open)
    local connected_rooms = {}
    if local_room ~= "" then connected_rooms[local_room] = true end

    local changed = true
    while changed do
      changed = false
      for w = 1, wall_count do
        if is_open(w) then

          local link_str = Controls["Wall_"..w.."_Linkage"].String
          local r1, r2 = link_str:match("(%w+)%s*%-%s*(%w+)")
          if not r1 then
             r1, r2 = link_str:match("(%w+)%s*,%s*(%w+)")
          end

          if r1 and r2 then
             if connected_rooms[r1] and not connected_rooms[r2] then
               connected_rooms[r2] = true
               changed = true
             elseif connected_rooms[r2] and not connected_rooms[r1] then
               connected_rooms[r1] = true
               changed = true
             end
          end
        end
      end
    end

    local room_list = {}
    for r, _ in pairs(connected_rooms) do table.insert(room_list, r) end
    table.sort(room_list)
    return table.concat(room_list)
  end

  local function GetTopologyString()
    return ComputeTopology(function(w) return Controls["Wall_"..w.."_Open"].Boolean end)
  end

  -- EVERY topology suffix this room can ever be in, across all wall combinations.
  -- UpdateUI must know these so a layer named for a WIDER topology (e.g. "Audio-AB")
  -- still gets explicitly hidden after the wall closes and we drop back to "A".
  -- Enumerating only the current suffix is what left both pages visible at once.
  local topo_variants = { local_room }

  local function RebuildTopoVariants()
    local seen, list = {}, {}
    local combos = math.floor(2 ^ wall_count + 0.5)
    if combos > 1024 then combos = 1024 end  -- guard the 10-wall worst case
    for mask = 0, combos - 1 do
      local t = ComputeTopology(function(w)
         return (math.floor(mask / (2 ^ (w - 1))) % 2) == 1
      end)
      if t ~= "" and not seen[t] then
         seen[t] = true
         table.insert(list, t)
      end
    end
    if #list == 0 then list = { local_room } end
    topo_variants = list
  end

  local function SyncBroadcast(cmd_str)
     local topo = GetTopologyString()
     for r in topo:gmatch(".") do
        if r ~= local_room and r ~= "" then
           pcall(function()
              local comp = Component.New(peer_prefix .. r)
              if comp and comp["RPC_Command"] then comp["RPC_Command"].String = cmd_str end
           end)
        end
     end
  end

  -- Authoritatively drives EVERY managed layer to its correct visibility (on AND
  -- off) on each call. Safe to call repeatedly -- unchanged layers re-assert quietly
  -- with no flicker. The periodic tick uses this to converge physical panels.
  local function UpdateUI()
    local topo_str = GetTopologyString()
    
    -- Priority 1: STRICTLY update physical boolean buttons instantly before any string scraping
    if sys_state == 0 then
      Controls.System_Power_State.Boolean = false
      for i=1, main_count do Controls["Main_Page_"..i].Boolean = false end
      for i=1, main_count do
         local sc = ResolveSubCount(i, Properties)
         for j=1, sc do Controls["Main_"..i.."_Sub_"..j].Boolean = false end
      end
    elseif sys_state == 1 then
      Controls.System_Power_State.Boolean = true
      for i=1, main_count do Controls["Main_Page_"..i].Boolean = (i == active_main) end

      for i=1, main_count do
         local sc = ResolveSubCount(i, Properties)
         for j=1, sc do
            Controls["Main_"..i.."_Sub_"..j].Boolean = (j == active_subs[i])
         end
      end
    elseif sys_state == 2 then
      Controls.System_Power_State.Boolean = true
      for i=1, main_count do Controls["Main_Page_"..i].Boolean = false end
      for i=1, main_count do
         local sc = ResolveSubCount(i, Properties)
         for j=1, sc do Controls["Main_"..i.."_Sub_"..j].Boolean = false end
      end
    end

    -- Priority 2: Execute explicit string formatting safely natively mapping to arrays
    local topo_idx = 0 
    
    for w = 1, wall_count do
      if Controls["Wall_"..w.."_Open"].Boolean then
        topo_idx = topo_idx + (2^(w-1))
      end
    end

    Controls.Current_Topology.String = topo_str
    
    local new_bg_layer = ""
    local new_sub_layer = ""
    local new_popup_layer = ""
    local bg_trans = "none"
    local sub_trans = "none"
    local pop_trans = "none"
    
    local shut_pg_name = ""
    if Controls.Shutdown_Page_TargetName then shut_pg_name = Controls.Shutdown_Page_TargetName.String end
    
    local function append_suffix(name, suffix)
       if wall_count == 0 then return name end
       if not suffix or suffix == "" then return name end
       return name .. "-" .. suffix
    end
    
    if sys_state == 0 then
      new_bg_layer = start_sys_page  -- powered OFF: show the Start System / welcome page
      bg_trans = Controls.Start_Transition.String

    elseif sys_state == 1 then
      local p_name = Controls["Main_Page_"..active_main.."_TargetName"].String
      if Controls["Main_Page_"..active_main.."_Local_Only"].Boolean then
         new_bg_layer = p_name  -- Local Only: bare layer name, no room/topology suffix
      else
         new_bg_layer = append_suffix(p_name, topo_str)
      end
      bg_trans = Controls["Main_Page_"..active_main.."_Transition"].String
      
      local master_sub_count = ResolveSubCount(active_main, Properties)
      if master_sub_count > 0 then
         local act_s = active_subs[active_main]
         if act_s > master_sub_count then act_s = master_sub_count end -- bounds check defense
         local s_name = Controls["Main_"..active_main.."_Sub_"..act_s.."_TargetName"].String
         if Controls["Main_Page_"..active_main.."_Local_Only"].Boolean then
            new_sub_layer = s_name  -- Local Only: bare layer name, no room/topology suffix
         else
            new_sub_layer = append_suffix(s_name, topo_str)
         end
         sub_trans = Controls["Main_"..active_main.."_Sub_"..act_s.."_Transition"].String
      end
      
    elseif sys_state == 2 then
      new_bg_layer = shut_pg_name
      bg_trans = Controls.Shutdown_Transition.String
    end
    
    -- Active popup layer (if any).
    if active_popup > 0 then
       new_popup_layer = Controls["Popup_"..active_popup.."_TargetName"].String
       pop_trans = Controls["Popup_"..active_popup.."_Transition"].String
    end

    -- ===== Authoritative layer application ===================================
    -- Build the set of layers that SHOULD be visible right now (layer -> transition
    -- to use when it first appears).
    local desired = {}
    local function want(layer, trans)
       if layer and layer ~= "" then desired[layer] = trans or "none" end
    end
    want(new_bg_layer, bg_trans)
    want(new_sub_layer, sub_trans)
    want(new_popup_layer, pop_trans)
    if sys_state ~= 0 then
       for i = 1, nav_count do
          want(Controls["Navigation_Menu_"..i.."_TargetName"].String,
               Controls["Navigation_Menu_"..i.."_Transition"].String)
       end
    end

    -- Drive ONE layer to its desired visibility. We ALWAYS write -- ON and OFF -- so
    -- any viewer that booted late or missed a command converges (this is what hides a
    -- stuck start page on a real panel). The configured transition is applied only on
    -- a real change; an unchanged re-assert uses "none" and is written quietly (no
    -- console spam, no flicker).
    local function drive(layer)
       if not layer or layer == "" then return end
       local wantVis = (desired[layer] ~= nil)
       local changed = (layer_state[layer] ~= wantVis)
       local trans = (changed and wantVis) and desired[layer] or "none"
       SetLayerSafe(layer, wantVis, trans, not changed)
       layer_state[layer] = wantVis
    end

    -- Enumerate EVERY layer this engine can manage, deduped, then drive each exactly
    -- once. Deduping matters: driving the same layer twice in one pass re-asserts it
    -- with a "none" transition and stomps the fade it was just given.
    local managed, managed_list = {}, {}
    local function manage(name)
       if name and name ~= "" and not managed[name] then
          managed[name] = true
          table.insert(managed_list, name)
       end
    end

    -- Bare (Local Only) + local room + every possible topology suffix. Covering all
    -- topologies -- not just the current one -- is what lets a stale "Page-AB" layer be
    -- hidden once the wall closes and the room drops back to "Page-A".
    local function manage_family(base)
       if not base or base == "" then return end
       manage(base)
       manage(append_suffix(base, local_room))
       for _, t in ipairs(topo_variants) do manage(append_suffix(base, t)) end
    end

    for i = 1, main_count do
       manage_family(Controls["Main_Page_"..i.."_TargetName"].String)
       local sc = ResolveSubCount(i, Properties)
       for j = 1, sc do
          manage_family(Controls["Main_"..i.."_Sub_"..j.."_TargetName"].String)
       end
    end
    for x = 1, popup_count do manage(Controls["Popup_"..x.."_TargetName"].String) end
    for i = 1, nav_count do manage(Controls["Navigation_Menu_"..i.."_TargetName"].String) end
    manage(start_sys_page)
    manage(shut_pg_name)
    for _, nm in ipairs(idle_hide_layers) do manage(nm) end

    -- Safety net: anything we previously drove VISIBLE but no longer enumerate (a
    -- TargetName was edited, linkage changed, wall count changed) still has to be
    -- hidden, or it stays on screen forever. layer_state remembers what we turned on.
    for name, vis in pairs(layer_state) do
       if vis and not managed[name] then manage(name) end
    end
    for name, _ in pairs(desired) do manage(name) end

    for _, name in ipairs(managed_list) do drive(name) end

    Controls.Current_Full_Page_Target.String = new_bg_layer
    Controls.Current_Secondary_Sub_Target.String = new_sub_layer
    Controls.Current_Popup_Target.String = new_popup_layer

    for i = 1, main_count do
      local sub_active = (sys_state == 1 and i == active_main)
      local alt_count = ComputePage1Subs(wall_count)
      for k = 0, alt_count - 1 do
         Controls["Main_Page_"..i.."_Alt_"..k.."_Active"].Boolean = (sub_active and k == topo_idx)
      end
    end
  end

  -- Apply the Sys Start dropdown (Start_Page_TargetName) selection to the active
  -- page state. The selection can be either a MAIN page target name or a SUBPAGE
  -- target name -- if it's a subpage we jump to its parent main page AND activate
  -- that subpage. Falls back to Main Page 1 if nothing matches.
  local function ApplyStartupSelection()
     local target = Controls.Start_Page_TargetName and Controls.Start_Page_TargetName.String or ""
     if target ~= "" then
        for i = 1, main_count do
           if Controls["Main_Page_"..i.."_TargetName"].String == target then
              active_main = i
              return
           end
        end
        for i = 1, main_count do
           local sc = ResolveSubCount(i, Properties)
           for j = 1, sc do
              if Controls["Main_"..i.."_Sub_"..j.."_TargetName"].String == target then
                 active_main = i
                 active_subs[i] = j
                 return
              end
           end
        end
     end
     active_main = 1
  end

  local function PerformSystemStart(trigger_pulse)
     if sys_state == 0 then
        sys_state = 1
        ApplyStartupSelection()
        SyncBroadcast("START")
        if trigger_pulse then Controls.System_Power_On_Pulse:Trigger() end
        UpdateUI()
     end
  end

  local function PerformShutdownConfirm(trigger_pulse)
    if sys_state ~= 0 then
       sys_state = 0
       active_popup = 0
       for x = 1, popup_count do Controls["Popup_"..x.."_Toggle"].Boolean = false end
       SyncBroadcast("SHUTDOWN_CONFIRM")
       if trigger_pulse then Controls.System_Power_Off_Pulse:Trigger() end
       UpdateUI()
    end
  end

  local function PerformAutoWake()
     if sys_state ~= 1 then
        PerformSystemStart(true)
     end
  end

  -- Reconcile power state across rooms that just became connected (or disconnected) via a wall change.
  -- Spec: "all connected rooms turn on and off together." So if a wall opens and any connected peer
  -- is already powered, the local panel must leave its Start page and follow. Conversely, if we
  -- are the powered room, we re-broadcast START so any newly-attached OFF rooms wake up.
  -- sys_state == 2 (shutdown_requested) is treated as transient; we don't drag peers into that state
  -- on a wall transition -- the user will either Confirm or Cancel via the existing sync paths.
  local function WallTopologySync()
    local topo_str = GetTopologyString()

    if sys_state == 1 then
      -- We are ON. Tell every peer in the new topology to start; PerformSystemStart on the
      -- receiving side is a no-op if it's already on, so this is safe for closed walls / no-op cases.
      SyncBroadcast("START")
      return
    end

    if sys_state == 0 then
      -- We are OFF. Probe each connected peer's System_Power_State directly via Component.New.
      -- If any peer is powered, perform a local start (which will SyncBroadcast START, but
      -- already-on peers will no-op on receipt, so there is no echo storm).
      for r in topo_str:gmatch(".") do
        if r ~= local_room and r ~= "" then
          local peer_on = false
          pcall(function()
            local comp = Component.New(peer_prefix .. r)
            if comp and comp["System_Power_State"] and comp["System_Power_State"].Boolean then
              peer_on = true
            end
          end)
          if peer_on then
            PerformSystemStart(true)
            return
          end
        end
      end
    end
  end

  Controls.RPC_Command.EventHandler = function(ctrl)
    local cmd = ctrl.String
    if cmd == "" then return end
    
    if cmd == "START" then
       PerformSystemStart(true)
    elseif cmd == "SHUTDOWN_REQ" then
       if sys_state == 1 then
          sys_state = 2
          UpdateUI()
       end
    elseif cmd == "SHUTDOWN_CONFIRM" then
       PerformShutdownConfirm(true)
    elseif cmd == "SHUTDOWN_CANCEL" then
       if sys_state == 2 then
          sys_state = 1
          UpdateUI()
       end
    else
       local action, param = cmd:match("(%w+)%|(%d+)")
       if action == "PRESET" then
          if sys_state == 1 then
             local p = tonumber(param)
             ApplyStartupSelection()
             UpdateUI()
          end
       end
    end
    ctrl.String = ""
  end

  Controls.System_Start.EventHandler = function() PerformSystemStart(true) end
  Controls.System_Power_On_Pulse.EventHandler = function() PerformSystemStart(false) end
  Controls.Shutdown_Confirm.EventHandler = function() PerformShutdownConfirm(true) end
  Controls.System_Power_Off_Pulse.EventHandler = function() PerformShutdownConfirm(false) end
  
  Controls.System_Shutdown_Request.EventHandler = function(ctrl)
    if sys_state == 1 then
       sys_state = 2
       SyncBroadcast("SHUTDOWN_REQ")
       UpdateUI()
    end
  end
  
  Controls.Shutdown_Cancel.EventHandler = function(ctrl)
    if sys_state == 2 then
       sys_state = 1
       SyncBroadcast("SHUTDOWN_CANCEL")
       UpdateUI()
    end
  end

  for i = 1, main_count do
    Controls["Main_Page_"..i].EventHandler = function(ctrl)
      PerformAutoWake()
      
      if ctrl.Boolean then
         if active_main ~= i then
            active_main = i
            UpdateUI()
         end
      else
         if active_main == i then
            ctrl.Boolean = true 
            UpdateUI()
         end
      end
    end
    Controls["Main_Page_"..i.."_Local_Only"].EventHandler = function() UpdateUI() end
    Controls["Main_Page_"..i.."_TargetName"].EventHandler = function() UpdateUI() end

    local s_cnt = ResolveSubCount(i, Properties)
    for j = 1, s_cnt do
       Controls["Main_"..i.."_Sub_"..j].EventHandler = function(ctrl)
          PerformAutoWake()
          
          if ctrl.Boolean then
             if active_subs[i] ~= j then
                active_subs[i] = j
                UpdateUI()
             end
          else
             if active_subs[i] == j then
                ctrl.Boolean = true
                UpdateUI()
             end
          end
       end
       Controls["Main_"..i.."_Sub_"..j.."_TargetName"].EventHandler = function() UpdateUI() end
    end
  end
  
  Controls.Close_Popup.EventHandler = function()
     if active_popup > 0 then
        active_popup = 0
        for x = 1, popup_count do Controls["Popup_"..x.."_Toggle"].Boolean = false end
        UpdateUI()
     end
  end
  
  for p = 1, popup_count do
    Controls["Popup_"..p.."_Toggle"].EventHandler = function(ctrl)
       -- NOTE: popups are overlays (help/info/settings/confirm) and must NOT
       -- power the system on. Do not call PerformAutoWake() here -- unlike main
       -- page / sub / preset taps, opening a popup is not a "use the system" intent.
       if ctrl.Boolean then
          if active_popup ~= p then
             active_popup = p
             for x = 1, popup_count do 
               if x ~= p then Controls["Popup_"..x.."_Toggle"].Boolean = false end 
             end
             UpdateUI()
          end
       else
          if active_popup == p then 
             ctrl.Boolean = true
             UpdateUI()
          end
       end
    end
    Controls["Popup_"..p.."_TargetName"].EventHandler = function() UpdateUI() end
  end
  
  for n = 1, nav_count do
    Controls["Navigation_Menu_"..n.."_TargetName"].EventHandler = function() UpdateUI() end
  end

  for p = 1, preset_count do
    Controls["Room_Preset_"..p].EventHandler = function(ctrl)
       PerformAutoWake()
       if sys_state == 1 and ctrl.Boolean then
          ApplyStartupSelection()
          SyncBroadcast("PRESET|"..p)
          UpdateUI()
       end
    end
  end
  
  local def_links = {"A-B", "B-C", "C-D", "D-E", "E-F", "F-G", "G-H", "H-I", "I-J", "J-K"}
  for w = 1, wall_count do
    if Controls["Wall_"..w.."_Linkage"].String == "" then Controls["Wall_"..w.."_Linkage"].String = def_links[w] or "X-Y" end
    -- Linkage defines the room graph, so the set of possible topologies changes with it.
    Controls["Wall_"..w.."_Linkage"].EventHandler = function()
       RebuildTopoVariants()
       UpdateUI()
    end
    Controls["Wall_"..w.."_Open"].EventHandler = function()
       UpdateUI()
       WallTopologySync()
    end
  end

  -- Build the possible-topology list now that the linkage defaults above are populated.
  RebuildTopoVariants()

  -- ---------------------------------------------------------------------------
  -- Read wall state DIRECTLY from the Wall State Manager component so panels stay
  -- in sync without each one needing its Wall_x_Open pin wired. We mirror the
  -- manager's Wall.#.Out boolean into our local Wall_x_Open control, then run the
  -- same reaction (UpdateUI + WallTopologySync) the wired pin would. The wired pin
  -- still works as a manual override. Setting a control from script does not fire
  -- its own EventHandler, so we invoke the reaction explicitly.
  -- ---------------------------------------------------------------------------
  local wall_mgr_comp = nil
  if wall_mgr_name ~= "" then
    pcall(function() wall_mgr_comp = Component.New(wall_mgr_name) end)
  end

  local function WallMgrPin(w)
    return (wall_pin_pat:gsub("#", tostring(w)))
  end

  local function ReadMgrWall(w)
    local v = nil
    pcall(function()
      local pin = WallMgrPin(w)
      if wall_mgr_comp and wall_mgr_comp[pin] then v = wall_mgr_comp[pin].Boolean end
    end)
    return v
  end

  local function SyncWallFromManager(w, react)
    local v = ReadMgrWall(w)
    if v == nil then return end
    if Controls["Wall_"..w.."_Open"].Boolean ~= v then
      Controls["Wall_"..w.."_Open"].Boolean = v
    end
    if react then
      UpdateUI()
      WallTopologySync()
    end
  end

  if wall_mgr_comp then
    for w = 1, wall_count do
      local pin = WallMgrPin(w)
      local ok = false
      pcall(function()
        if wall_mgr_comp[pin] then
          wall_mgr_comp[pin].EventHandler = function() SyncWallFromManager(w, true) end
          ok = true
        end
      end)
      if not ok then
        print(string.format("Wall manager '%s' pin '%s' not found; relying on wired Wall_%d_Open.", wall_mgr_name, pin, w))
      end
    end
  end

  if Controls.Start_Page_TargetName then Controls.Start_Page_TargetName.EventHandler = function() UpdateUI() end end
  if Controls.Shutdown_Page_TargetName then Controls.Shutdown_Page_TargetName.EventHandler = function() UpdateUI() end end

  -- Auto-populate the TargetName ComboBox Choices on plugin load so users see the dropdown
  -- without having to press 'Pull Live UCI Targets' first. Fails gracefully via the strategy chain.
  pcall(ScrapeUciLayers)

  -- Prime each wall from the manager at boot so the topology is correct from the
  -- first paint. We don't react (no auto-wake) here -- boot intentionally starts OFF.
  if wall_mgr_comp then
    for w = 1, wall_count do SyncWallFromManager(w, false) end
  end

  -- Explicitly initialize system to OFF state when program is sent or rebooted
  Controls.System_Power_Off_Pulse:Trigger()

  -- Evaluate UI state at boot so the Start_Page is actively tracked for the first transition off.
  UpdateUI()

  -- Periodic convergence tick: re-assert the layers that should be visible every few
  -- seconds (cheap, "none" transitions). This makes a physical panel that booted late,
  -- reconnected, or dropped a layer command converge to the script's state -- the usual
  -- cause of "works in the emulator, different on the panel".
  local reassert_timer = Timer.New()
  reassert_timer.EventHandler = function()
     UpdateUI()
     reassert_timer:Start(3)  -- re-arm (Q-SYS timers are one-shot)
  end
  reassert_timer:Start(3)

end
